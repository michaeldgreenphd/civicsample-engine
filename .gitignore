# Transient extraction output — the raw weekly dump is uploaded to Google
# Drive and split into parts; it is never committed.
data/demographics.json
data/demographics.json.gz
data/demographics.part*.json.gz
data/dashboard-summary.json
data/industry_sponsors.json

# Full document corpora live outside git (1,400+ FDA PDFs, full manuscript
# archives). Only the pilot subsets are tracked so GitHub Actions can run
# the pilot extractions.
data/fda_pdfs/
data/AIML Manuscripts/
data/FDA Summary Statements/
data/Clinical Trials Manuscripts/*
!data/Clinical Trials Manuscripts/.gitkeep

# Never commit credentials
vertex_key.json
*.pem

# Site checkout created by the publish steps in CI (and by local testing)
site/
